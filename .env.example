# Copy to `.env` (repo root). Single env source for docker compose, apps/web and packages/db.
# Values below match docker-compose.yml defaults; ports are bound to 127.0.0.1 only.
# Postgres uses host port 5433 so it never collides with a natively installed Postgres on 5432.

# --- docker compose (optional overrides; defaults shown) ---
POSTGRES_USER=hacker
POSTGRES_PASSWORD=hacker
POSTGRES_DB=hacker_house
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- app (validated at startup: apps/web/src/server/env.ts) ---
DATABASE_URL=postgresql://hacker:hacker@127.0.0.1:5433/hacker_house
REDIS_URL=redis://127.0.0.1:6379
