# Copy to `.env` (repo root). Single env source for docker compose, apps/web and packages/db.
# Values below match docker-compose.yml defaults; ports are bound to 127.0.0.1 only.
# Postgres uses host port 5433 so it never collides with a natively installed Postgres on 5432.

# --- docker compose (optional overrides; defaults shown) ---
POSTGRES_USER=hacker
POSTGRES_PASSWORD=hacker
POSTGRES_DB=hacker_house
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- app (validated at startup: apps/web/src/server/env.ts) ---
DATABASE_URL=postgresql://hacker:hacker@127.0.0.1:5433/hacker_house
REDIS_URL=redis://127.0.0.1:6379
# LOG_LEVEL=info                    # debug | info | warn | error

# Pool + transaction timing (optional; defaults shown). Tuned by measurement in step 3.4.
# Budget per Postgres: (instances + 1) x DATABASE_POOL_MAX + ~15 for tools <= 97.
# DATABASE_POOL_MAX=10
# DATABASE_TX_MAX_WAIT_MS=5000      # wait for a free connection (transactions + plain queries)
# DATABASE_TX_TIMEOUT_MS=10000      # max length of a transaction (app-side timer)
# DATABASE_LOCK_TIMEOUT_MS=5000     # SET LOCAL lock_timeout; must be < DATABASE_TX_TIMEOUT_MS

# --- auth (Better Auth) ---
# Signs session cookies. Dev placeholder below is REFUSED when NODE_ENV=production.
# Generate a real one: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Real-time events (step 6.1). EVENT_BUS: redis (default; between instances) | memory (one
# process). EVENTS_CHANNEL separates apps sharing one Redis (pub/sub ignores Redis DB numbers).
# EVENT_BUS=redis
# EVENTS_CHANNEL=hh:events
# Dev probes in a production build — test harnesses only, never in a real deploy.
# ENABLE_DEV_PROBES=

# Live stream /api/stream (step 6.2): heartbeat interval; base stream lifetime (each stream: random in [base, base x 4/3]);
# concurrent streams per user; bytes queued for a client that isn't reading before cutting it off.
# SSE_HEARTBEAT_MS=25000
# SSE_MAX_LIFETIME_MS=2700000
# SSE_MAX_STREAMS_PER_USER=5
# SSE_BUFFER_BYTES=262144

# Rate limiting (Phase 7). Limits live in apps/web/src/server/ratelimit/rules.ts; override some
# as rule=LIMIT/WINDOW pairs (WINDOW: number + s|m|h), comma-separated. Unknown rules stop startup.
# RATE_LIMIT_OVERRIDES=redeem.user=3/60s,redeem.ip=100/10m
# Local dev has no nginx, so every request's IP is "unknown" (one shared bucket): raise the
# IP-keyed auth limits there, e.g.
# RATE_LIMIT_OVERRIDES=signup.ip=1000/1h,signin.ip=1000/15m
