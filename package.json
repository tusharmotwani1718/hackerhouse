{
  "name": "hacker-house",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "db:generate": "turbo run generate --filter=@hacker-house/db",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:deploy": "bun run --cwd packages/db deploy",
    "db:studio": "bun run --cwd packages/db studio",
    "admin": "bun apps/web/scripts/admin.ts",
    "gen:timezones": "bun apps/web/scripts/gen-timezones.ts",
    "test:race": "bun run --cwd apps/web test:race",
    "load:seed": "bun apps/web/load/seed.ts",
    "load:serve": "bun apps/web/load/serve.ts",
    "load:board": "k6 run apps/web/load/board.k6.js",
    "test:api": "bun run --cwd apps/web test:api"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "@types/bun": "^1.4.4"
  }
}
