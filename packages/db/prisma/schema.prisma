// Models are added step by step. See specs/result/02_Schema.md.
// Hand-written SQL rules (CHECKs, partial indexes, DEFERRABLE FKs): specs/result/08_Spike_Results.md §S3.
// Conventions: UUIDv7 ids generated by Postgres (`uuidv7()`), snake_case columns, timestamptz.
// Timestamps come from ONE clock, Postgres's: `@default(dbgenerated("transaction_timestamp()"))`.
// Never `@default(now())` or `@updatedAt`: Prisma fills those in the app with the app server's
// clock. transaction_timestamp() is exactly Postgres's now() (the transaction's start time, so
// every row a transaction writes gets the same timestamp), spelled so that Prisma doesn't read
// it back as its own now() and report drift forever. Raw SQL may use now() (same function).
// Exception: Better Auth's tables, where Better Auth sends its own values.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — Better Auth core tables (step 1.1). Better Auth does not generate ids
// (`advanced.database.generateId: false`); Postgres does.
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN

  @@map("user_role")
}

/// Better Auth `user`, stored as `users` (`user` is a reserved word in Postgres).
model User {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  /// Lowercased by Better Auth on sign-up and sign-in; scripts inserting users must lowercase too.
  email         String   @unique
  /// Better Auth core column; unused (no email verification, R15).
  emailVerified Boolean  @default(false) @map("email_verified")
  /// Better Auth core column; unused (no profile image, R15).
  image         String?
  /// Not settable at sign-up (`input: false`); admins are created by the CLI only (R14).
  role          Role     @default(USER)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Profile (step 1.3). Not declared to Better Auth → never settable through sign-up.
  /// Self-entered, unverified, NOT unique (04 §1.3). Lowercase; hand-written CHECK on format.
  githubUsername String? @map("github_username")
  /// Optional; https:// only, ≤ 2048 chars (hand-written CHECK).
  portfolioUrl   String? @map("portfolio_url")
  /// Canonical IANA name (validated in the app against tzdata; R16).
  timezone       String  @default("Asia/Kolkata")

  sessions     Session[]
  accounts     Account[]
  skills       UserSkill[]
  hackathons   Hackathon[]
  participants Participant[]
  inviteCodes  InviteCode[]
  idempotency  IdempotencyKey[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Hackathons (step 2.1, 02 §3.2). Created by admins only (R14); no edit/delete in v1.
// ---------------------------------------------------------------------------

model Hackathon {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// 3–100 chars, trimmed (hand-written CHECK).
  name            String
  /// URL id: lowercase letters/digits, single hyphens, 3–60 chars (hand-written CHECK).
  slug            String   @unique
  /// 0–5000 chars (hand-written CHECK).
  description     String   @default("")
  /// 1 ≤ min ≤ max ≤ 10 (hand-written CHECK). IMMUTABLE (R10): teams copy max_team_size into
  /// their own row; a hand-written trigger rejects any UPDATE of either size.
  minTeamSize     Int      @map("min_team_size") @db.SmallInt
  maxTeamSize     Int      @map("max_team_size") @db.SmallInt
  /// Must be an ADMIN when created (checked in the app). RESTRICT: the creator can't be deleted.
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz
  /// No updates in v1. Any future update must set updated_at = now() itself.
  updatedAt       DateTime @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz

  createdBy    User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants Participant[]
  teams        Team[]

  /// Target of the teams FK (hackathon_id, max_size): a team's max_size always equals this.
  @@unique([id, maxTeamSize])
  @@index([createdByUserId])
  @@map("hackathons")
}

// ---------------------------------------------------------------------------
// Participants (step 2.2, 02 §3.3): a user registered in a hackathon. The row is the lock
// target for "this user in this hackathon" in later flows (I1). Membership = team_id on this
// row (02 §2): one column → at most one team per hackathon (R2), structurally.
// ---------------------------------------------------------------------------

model Participant {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  hackathonId  String    @map("hackathon_id") @db.Uuid
  /// Changes only under this row's lock AND the team's lock (I2, I3). Step 3.1.
  teamId       String?   @map("team_id") @db.Uuid
  /// Set iff team_id is set (hand-written CHECK). Oldest member succeeds a leaving leader (R6).
  teamJoinedAt DateTime? @map("team_joined_at") @db.Timestamptz
  /// Registration time.
  createdAt    DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Restrict)
  /// Composite FK: the team must be in the SAME hackathon. RESTRICT: a team with members
  /// can't be deleted (R7 safety net). Unchecked while team_id is NULL (MATCH SIMPLE).
  team      Team?     @relation("members", fields: [teamId, hackathonId], references: [id, hackathonId], onDelete: Restrict, onUpdate: Restrict, map: "participants_team_fkey")
  /// Back side of teams_leader_fkey (a list: Prisma would otherwise demand a unique index).
  leads     Team[]    @relation("leader")

  /// R3: register once per hackathon. Also resolves concurrent duplicate registrations (Flow 5).
  @@unique([userId, hackathonId])
  /// Target for composite FKs (teams, join requests) that pin rows to the same hackathon.
  @@unique([id, hackathonId])
  /// Target for teams_leader_fkey: "the leader is a member of THIS team".
  @@unique([id, teamId])
  /// Stats counts; the (user_id, hackathon_id) index leads with user_id, so it can't serve them.
  @@index([hackathonId])
  /// List members; find the next leader (oldest member). Also serves participants_team_fkey.
  @@index([teamId, teamJoinedAt])
  @@map("participants")
}

// ---------------------------------------------------------------------------
// Teams (step 3.1, 02 §3.4). The row is the lock target for "a seat on this team" (I1).
// ---------------------------------------------------------------------------

enum JoinPolicy {
  OPEN
  APPROVAL

  @@map("join_policy")
}

enum TeamAccess {
  PUBLIC
  INVITE_ONLY

  @@map("team_access")
}

model Team {
  id                  String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Immutable (hand-written trigger teams_immutable_columns).
  hackathonId         String     @map("hackathon_id") @db.Uuid
  /// 3–40 chars, trimmed (hand-written CHECK). Unique per hackathon, case-insensitive (R18):
  /// hand-written unique index on (hackathon_id, lower(name)).
  name                String
  /// 0–500 chars (hand-written CHECK).
  description         String     @default("")
  /// Immutable (trigger).
  joinPolicy          JoinPolicy @map("join_policy")
  /// Immutable (trigger).
  access              TeamAccess
  /// Board listing only; does not block joins (R21).
  isLooking           Boolean    @default(true) @map("is_looking")
  /// Exactly one leader, who is a member (R4): deferred composite FK teams_leader_fkey.
  leaderParticipantId String     @map("leader_participant_id") @db.Uuid
  /// Denormalized; changed only under the team lock. 1 ≤ member_count ≤ max_size (CHECK, R1/R5/R7).
  memberCount         Int        @map("member_count") @db.SmallInt
  /// Copied from the hackathon; the FK (hackathon_id, max_size) keeps it equal. Immutable (trigger).
  maxSize             Int        @map("max_size") @db.SmallInt
  /// +1 on every change (SSE ordering). ≥ 1 (CHECK).
  version             Int        @default(1)
  createdAt           DateTime   @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz
  /// Set by the team-update helper (with version + 1) on every change, never by Prisma.
  updatedAt           DateTime   @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz

  /// One FK does both jobs: the hackathon exists AND max_size equals its max_team_size.
  hackathon   Hackathon     @relation(fields: [hackathonId, maxSize], references: [id, maxTeamSize], onDelete: Restrict, onUpdate: Restrict, map: "teams_hackathon_fkey")
  /// (leader_participant_id, id) → participants (id, team_id): the leader's team_id must be
  /// THIS team. Hand-written DEFERRABLE INITIALLY DEFERRED → checked at COMMIT (08 §S3).
  leader      Participant   @relation("leader", fields: [leaderParticipantId, id], references: [id, teamId], onDelete: NoAction, onUpdate: NoAction, map: "teams_leader_fkey")
  members     Participant[] @relation("members")
  inviteCodes InviteCode[]

  /// Target for composite FKs (participants, join requests).
  @@unique([id, hackathonId])
  /// All Teams list (keyset order, 05 RD3). The board's partial index is hand-written.
  @@index([hackathonId, createdAt(sort: Desc), id(sort: Desc)])
  /// Name search: ILIKE '%q%' (needs pg_trgm, created at the top of the migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "teams_name_trgm_idx")
  /// Changing a participant's team_id re-checks teams_leader_fkey from this side → needs an index.
  @@index([leaderParticipantId])
  @@map("teams")
}

// ---------------------------------------------------------------------------
// Invite codes (step 3.1, 02 §3.5). Never exposed publicly; generated in step 3.3.
// ---------------------------------------------------------------------------

model InviteCode {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  /// 10 chars Crockford base32, uppercase, no hyphens (hand-written CHECK). Unique.
  code            String    @unique
  /// > created_at (hand-written CHECK); the 1h–30d bound is validated in the app.
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  /// At most one non-revoked code per team (hand-written partial unique index).
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Serves the cascade from teams (the partial unique index covers active codes only).
  @@index([teamId])
  @@index([createdByUserId])
  @@map("invite_codes")
}

// ---------------------------------------------------------------------------
// Audit log (step 3.1, 02 §3.8). Append-only (hand-written trigger). NO foreign keys on
// purpose: history must outlive deleted teams, participants and users.
// ---------------------------------------------------------------------------

enum AuditAction {
  PARTICIPANT_REGISTERED
  PARTICIPANT_WITHDREW
  TEAM_CREATED
  TEAM_DELETED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  LEADER_CHANGED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_DECLINED
  REQUEST_CANCELLED
  LOOKING_TOGGLED
  INVITE_CODE_GENERATED
  INVITE_CODE_REVOKED
  // Admin actions (3.1 decision D4): not tied to a team; visible via the admin audit endpoint only.
  HACKATHON_CREATED
  ADMIN_CREATED
  USER_PROMOTED
  USER_DEMOTED
  PASSWORD_RESET

  @@map("audit_action")
}

model AuditLog {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// NULL for actions not tied to a hackathon (admin CLI).
  hackathonId  String?     @map("hackathon_id") @db.Uuid
  teamId       String?     @map("team_id") @db.Uuid
  /// NULL = done from the admin CLI (no signed-in user).
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  targetUserId String?     @map("target_user_id") @db.Uuid
  action       AuditAction
  metadata     Json        @default("{}")
  /// Correlates with request log lines; NULL for CLI actions.
  requestId    String?     @map("request_id")
  /// All rows of one transaction share this value; uuidv7 ids (monotonic per session) keep their order.
  createdAt    DateTime    @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz

  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([hackathonId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Profile — skills (step 1.3, 02 §3.9). Level 0 = no row.
// ---------------------------------------------------------------------------

enum Skill {
  FRONTEND
  BACKEND
  MOBILE
  AI_ML
  DATA
  DEVOPS_CLOUD
  UI_UX_DESIGN
  PRODUCT
  BLOCKCHAIN
  SECURITY
  HARDWARE_IOT
  GAME_DEV

  @@map("skill")
}

model UserSkill {
  userId String @map("user_id") @db.Uuid
  skill  Skill
  /// 1–5 (hand-written CHECK); a skill at level 0 has no row.
  level  Int    @db.SmallInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@map("user_skills")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Opaque token; the cookie carries `token.signature` (HMAC with BETTER_AUTH_SECRET).
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Credentials: `provider_id = 'credential'` rows hold the scrypt password hash.
/// GitHub (later) adds `provider_id = 'github'` rows → "verified" badge.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Better Auth core table; unused in v1 (no email verification / password reset).
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Idempotency keys (step 3.2, 02 §3.7, 01 §8). Claimed as the FIRST statement of the
// mutation's own transaction, response stored before COMMIT → a stored response exists
// exactly when the work committed. Cleanup of expired rows: Phase 11 job.
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Client's `Idempotency-Key` header: 8–128 chars [A-Za-z0-9_-] (hand-written CHECK).
  key            String
  /// sha256(method + path + canonical validated body); same key + other hash → 422.
  requestHash    String   @map("request_hash")
  /// Status + body are both NULL (claimed, transaction still running) or both set.
  responseStatus Int?     @map("response_status") @db.SmallInt
  /// `json`, not `jsonb`: keeps the exact text (key order), so replays are byte-identical.
  responseBody   Json?    @map("response_body") @db.Json
  createdAt      DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz
  /// created_at + 24 h. An expired row still present is taken over by the next claim.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Keys are per user. Concurrent duplicates wait on this index (insert-first ordering).
  @@unique([userId, key])
  /// Cleanup job (batched DELETE … WHERE expires_at < now(), 06 §8).
  @@index([expiresAt])
  @@map("idempotency_keys")
}
